# ---------------------------------------------------------------------------
# Database (PostgreSQL via docker-compose.yml)
# The compose `db` service uses these. In production docker-compose overrides
# DATABASE_URL for the app container to reach the database as host "db"; the
# value below is for running Next.js / Prisma on the host.
# ---------------------------------------------------------------------------
POSTGRES_USER="portfolio"
# URL-safe characters only — it's embedded in DATABASE_URL (`openssl rand -hex 24`).
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="portfolio"
DATABASE_URL="postgresql://portfolio:change-me@127.0.0.1:5432/portfolio"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
CONTACT_TO_EMAIL="contactshakibhere@gmail.com"
CONTACT_FROM_EMAIL="Portfolio <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis — optional; falls back to in-memory in dev)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# AUTH_SECRET signs session cookies — 32+ random chars: `openssl rand -base64 48`.
# ADMIN_EMAIL + ADMIN_PASSWORD create the account on the first sign-in only;
# afterwards change the password in Admin → Settings and remove it from here.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Where uploaded images/PDFs are stored. docker-compose sets /app/uploads.
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# Production on the VPS (docker-compose.prod.yml — see deploy/README.md)
# APP_PORT is the localhost port nginx proxies to. APP_TAG is the deployed
# image tag; deploy/deploy.sh sets it, don't edit it by hand.
# ---------------------------------------------------------------------------
# APP_PORT=3350
# APP_TAG=
